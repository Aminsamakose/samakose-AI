  "private": true,
  "description": "Samakose AI Business Health OS: SME360, AgriFood360 and ESO360 web platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
