# Core
DATABASE_URL=postgres://samakose:change-me@localhost:5432/samakose
APP_URL=http://localhost:3000
SESSION_SECRET=generate-with-openssl-rand-hex-32
NODE_ENV=production

# Security
MFA_REQUIRED_ROLES=ADMIN,REVIEWER
CRON_SECRET=generate-with-openssl-rand-hex-24
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=1

# AI (mock returns canned replies for demos and tests; use claude in production)
AI_MODE=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Which provider answers live AI: anthropic (default), openai, or openai-compatible (Gemini, Mistral, Groq, Azure and others via OPENAI_BASE_URL).
# Changing provider changes where client data is sent and how the answers read: re-run each agent's evaluation first, and update the privacy notice.
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# KoboToolbox
KOBO_WEBHOOK_SECRET=generate-with-openssl-rand-hex-24
KOBO_SERVER=https://kf.kobotoolbox.org
KOBO_TOKEN=
KOBO_ASSET_UID=

# Paystack (mock mode is used when the secret key is empty)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (log-only when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Samakose <no-reply@samakose.com>

# Files: local disk by default. Mount a persistent volume at STORAGE_DIR.
# On Vercel, link a Vercel Blob store (Storage tab) and the driver switches to blob by itself.
# Or set STORAGE_DRIVER=s3 and fill the S3_* values below. Leave unset for local disk.
# STORAGE_DRIVER=disk
STORAGE_DIR=./storage
# S3-compatible storage: AWS S3, Cloudflare R2 or Supabase Storage (S3 endpoint from Storage settings)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
# Defaults to 10, or 4 on Vercel (its request body limit is 4.5 MB)
# MAX_UPLOAD_MB=10

# Google sign-in for business owners (optional). Leave empty to hide the button.
# Redirect URI to register in Google Cloud: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where website enquiries are sent. Defaults to info@samakose.com.
INQUIRY_TO=
# Direct database connection with rights to create databases. Used only by npm run db:rehearse, never by the app.
ADMIN_DATABASE_URL=
# Pool size and connection timeout for the app database connection.
DB_POOL_MAX=
DB_CONNECT_TIMEOUT_MS=
# Set to 1 only for a demonstration. Mock payments are refused in production unless this is 1, and the billing check flags it.
ALLOW_MOCK_PAYMENTS=
# Set to 1 on a host that runs the worker separately, so web requests do not run jobs in process.
DISABLE_INPROCESS_JOBS=
# Current rate card in USD per million tokens, used by the live AI evaluation script and spend estimates.
PRICE_IN_USD=
PRICE_OUT_USD=
# First administrator for a new database (used by the seed script). Choose a strong password and change it at first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to 1 to load demonstration data. Never on production.
SEED_DEMO=
