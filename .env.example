# Core
DATABASE_URL=postgres://samakose:change-me@localhost:5432/samakose
APP_URL=http://localhost:3000
SESSION_SECRET=generate-with-openssl-rand-hex-32
NODE_ENV=production

# Security
MFA_REQUIRED_ROLES=ADMIN,REVIEWER
CRON_SECRET=generate-with-openssl-rand-hex-24
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=1

# AI (mock returns canned replies for demos and tests; use claude in production)
AI_MODE=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# KoboToolbox
KOBO_WEBHOOK_SECRET=generate-with-openssl-rand-hex-24
KOBO_SERVER=https://kf.kobotoolbox.org
KOBO_TOKEN=
KOBO_ASSET_UID=

# Paystack (mock mode is used when the secret key is empty)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (log-only when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Samakose <no-reply@samakose.com>

# Files: local disk by default. Mount a persistent volume at STORAGE_DIR.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
